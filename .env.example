# --- App ---
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# --- Database (Postgres in compose) ---
DATABASE_URL=postgresql://infra:infra@db:5432/infra_requirements?schema=public

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated allowed Google Workspace domains (leave blank to allow any)
ALLOWED_EMAIL_DOMAINS=

# --- Roles ---
# Comma-separated emails that should be granted ADMIN/INFRA on first login
ADMIN_EMAILS=
INFRA_EMAILS=
MANAGER_EMAILS=

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Infra Requirements <no-reply@example.com>"
# Set to "true" to log emails to stdout instead of sending (useful before SMTP is configured)
MAIL_DRY_RUN=true

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25

# --- Scheduler ---
# Cron expression for the daily alert sweep (server timezone). Default 09:00 daily.
ALERT_CRON="0 9 * * *"
# Set to "false" to disable the in-app scheduler (e.g. when running a separate worker)
ENABLE_SCHEDULER=true
