generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  INFRA
  ADMIN
}

enum Environment {
  DEV
  STAGING
  PROD
  DR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  PROVISIONED
  EXPIRED
  SHUTDOWN
}

enum AlertKind {
  PRE_EXPIRY_WARNING
  POST_EXPIRY_DAILY
  SHUTDOWN_NOTICE
  STATUS_CHANGE
  NEW_REQUIREMENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(USER)
  team      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  raisedRequirements  Requirement[] @relation("Raiser")
  managedRequirements Requirement[] @relation("Manager")
}

model Requirement {
  id          String            @id @default(cuid())
  title       String
  description String?
  projectName String
  environment Environment       @default(DEV)
  priority    Priority          @default(MEDIUM)
  status      RequirementStatus @default(SUBMITTED)

  // Aggregate counts (derived from VmSpec[]; kept for fast filtering)
  vmCount Int @default(0)

  // Kubernetes (namespace-level quota — pod-level sizing is left to deployments)
  needsK8s          Boolean  @default(false)
  k8sNamespace      String?
  nsQuotaCpu        Int?     // total vCPU cores for the namespace
  nsQuotaMemoryGB   Int?     // total memory in GB for the namespace
  nsQuotaStorageGB  Int?     // total persistent storage in GB
  utilityServices   String[] @default([]) // Kafka, Redis, NiFi, RabbitMQ, MongoDB, ...

  // Network / extras
  needsLoadBalancer Boolean @default(false)
  needsPublicIp     Boolean @default(false)
  needsDatabase     Boolean @default(false)
  databaseEngine    String?
  storageGB         Int? // additional shared/object storage

  // Lifecycle
  raisedAt      DateTime  @default(now())
  startDate     DateTime?
  tenureDays    Int
  expiryDate    DateTime
  costCenter    String?
  justification String

  // Infra provisioning record (filled by INFRA after provisioning)
  provisionedAt           DateTime?
  provisionedNamespace    String?
  provisioningNotes       String?

  raiserId     String
  raiser       User    @relation("Raiser", fields: [raiserId], references: [id])
  managerId    String?
  manager      User?   @relation("Manager", fields: [managerId], references: [id])
  managerEmail String
  managerName  String

  vmSpecs     VmSpec[]
  attachments Attachment[]
  alertLogs   AlertLog[]
  events      RequirementEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiryDate])
  @@index([raiserId])
}

model VmSpec {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  // Requested (filled by raiser)
  name      String // logical name, e.g. "web-1"
  purpose   String?
  cpu       Int // vCPU
  memoryGB  Int
  storageGB Int
  osImage   String?

  // Provisioned (filled by INFRA team)
  hostname  String?
  ipAddress String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
}

model Attachment {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  kind          String      @default("BOQ")
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  uploadedById  String?
  uploadedAt    DateTime    @default(now())
}

model AlertLog {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  kind          AlertKind
  dayOffset     Int
  recipients    String
  subject       String
  sentAt        DateTime    @default(now())

  @@unique([requirementId, kind, dayOffset])
  @@index([requirementId])
}

model RequirementEvent {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  actorEmail    String?
  type          String
  message       String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([requirementId])
}

// --- NextAuth tables ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
