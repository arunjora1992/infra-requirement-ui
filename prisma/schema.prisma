generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  INFRA
  ADMIN
}

enum Environment {
  DEV
  STAGING
  PROD
  DR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  PROVISIONED
  EXPIRED
  SHUTDOWN
}

enum AlertKind {
  PRE_EXPIRY_WARNING
  POST_EXPIRY_DAILY
  SHUTDOWN_NOTICE
  STATUS_CHANGE
  NEW_REQUIREMENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  role          Role     @default(USER)
  team          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  raisedRequirements   Requirement[] @relation("Raiser")
  managedRequirements  Requirement[] @relation("Manager")
}

model Requirement {
  id              String            @id @default(cuid())
  title           String
  description     String?
  team            String
  environment     Environment       @default(DEV)
  priority        Priority          @default(MEDIUM)
  status          RequirementStatus @default(SUBMITTED)

  // Compute
  vmCount         Int               @default(0)
  vmCpu           Int?              // cores per VM
  vmMemoryGB      Int?              // RAM per VM
  vmStorageGB     Int?              // disk per VM
  osImage         String?

  podCount        Int               @default(0)
  podCpu          String?           // e.g. "500m"
  podMemory       String?           // e.g. "1Gi"
  k8sCluster      String?
  k8sNamespace    String?

  // Network / extras
  needsLoadBalancer Boolean         @default(false)
  needsPublicIp     Boolean         @default(false)
  needsDatabase     Boolean         @default(false)
  databaseEngine    String?
  storageGB         Int?            // additional shared/object storage

  // Lifecycle
  raisedAt        DateTime          @default(now())
  startDate       DateTime?
  tenureDays      Int               // requirement tenure
  expiryDate      DateTime
  costCenter      String?
  justification   String?

  raiserId        String
  raiser          User              @relation("Raiser", fields: [raiserId], references: [id])
  managerId       String?
  manager         User?             @relation("Manager", fields: [managerId], references: [id])
  managerEmail    String            // capture even if manager has no account yet
  managerName     String

  attachments     Attachment[]
  alertLogs       AlertLog[]
  events          RequirementEvent[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([expiryDate])
  @@index([raiserId])
}

model Attachment {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  kind          String      @default("BOQ") // BOQ, OTHER
  originalName  String
  storedName    String      // filename on disk
  mimeType      String
  sizeBytes     Int
  uploadedById  String?
  uploadedAt    DateTime    @default(now())
}

model AlertLog {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  kind          AlertKind
  // For PRE_EXPIRY_WARNING this is the warning day (e.g. 7).
  // For POST_EXPIRY_DAILY this is days-past-expiry (1..7).
  // For SHUTDOWN_NOTICE this is 7 (always once).
  dayOffset     Int
  recipients    String      // comma-separated emails
  subject       String
  sentAt        DateTime    @default(now())

  @@unique([requirementId, kind, dayOffset])
  @@index([requirementId])
}

model RequirementEvent {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  actorEmail    String?
  type          String      // CREATED, STATUS_CHANGED, ATTACHMENT_ADDED, etc.
  message       String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([requirementId])
}

// --- NextAuth tables ---
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
